# Rust
/target/
**/*.rs.bk
*.pdb

# Local runtime data — never commit an index or anything derived from personal files
/data/
/.marrow/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Models and weights — content-addressed, fetched on demand, never in git
/models/
*.gguf
*.onnx
*.safetensors

# Benchmark and corpus output (may contain real paths/filenames)
/bench/results/
/corpus/*
# …except the adversarial corpus, which is source: it is the gate every write
# tool ships behind, and a gate that is not in the repository is not a gate.
# (Git cannot re-include a path inside an excluded *directory*, which is why
# the line above ends in `*` rather than `/`.)
!/corpus/adversarial/
*.bench.json

# Diagnostics and logs
/logs/
*.log
diagnostics-*.zip

# Node (only if a UI lands post-M6)
node_modules/
dist/
.vite/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Secrets - belt and braces; nothing here should ever exist (SEC-005: use the OS keyring)
.env
.env.*
*.pem
*.key
# Config files called `secrets.*`, anywhere. Deliberately NOT bare `secrets.*`:
# that also matched `crates/model/src/secrets.rs`, the module that talks to the
# keyring, so the file was silently left out of every commit and CI failed on a
# missing module while it sat in the working tree. `git add` says nothing when
# it skips an ignored path, which is what made it invisible for a whole day.
secrets.json
secrets.toml
secrets.yaml
secrets.yml
secrets.env

# Spike is throwaway; keep the source, drop the build
/spike/target/
